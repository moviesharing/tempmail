---
import { getCollection } from "astro:content";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import ArticleCard from "../../../components/ArticleCard.astro";

const pageSize = 2;

export async function getStaticPaths() {
  const allPosts = (await getCollection("blog")).sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());
  const pageSize = 2;
  const pageCount = Math.ceil(allPosts.length / pageSize);
  return Array.from({ length: Math.max(0, pageCount - 1) }, (_, index) => {
    const page = index + 2;
    return { params: { page: String(page) }, props: { page } };
  });
}

const { page } = Astro.props;
const allPosts = (await getCollection("blog")).sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());
const visible = allPosts.slice((page - 1) * pageSize, page * pageSize);
---

<BaseLayout title={`Blog — Page ${page} — TempMail`} description="More practical guides to temporary email, privacy, and email security." noindex>
  <div class="page-wrap archive-page">
    <nav class="breadcrumbs" aria-label="Breadcrumb"><a href="/">Home</a><span>/</span><a href="/blog/">Blog</a><span>/</span><span>Page {page}</span></nav>
    <header class="archive-header"><p class="eyebrow">Field notes · Page {page}</p><h1>More from the blog.</h1></header>
    <div class="archive-tools"><label class="search-field"><span class="sr-only">Search articles</span><input type="search" placeholder="Search articles…" autocomplete="off" data-blog-search /><span aria-hidden="true">⌕</span></label></div>
    <div class="article-card-grid archive-grid">{visible.map((post) => <ArticleCard post={post} />)}</div>
    <p class="search-empty" data-search-empty hidden>No articles match that search. Try another word.</p>
    <nav class="pagination" aria-label="Blog pages"><a href="/blog/">← Previous</a><a href="/blog/">1</a><span aria-current="page">{page}</span></nav>
  </div>
  <script>
    import "../../../scripts/blog-search.js";
  </script>
</BaseLayout>
