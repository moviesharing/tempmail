<section class="mailbox-section" aria-labelledby="mailbox-heading" id="mailbox">
  <div class="mailbox-intro">
    <p class="eyebrow">A useful layer between you and the inbox</p>
    <h1 id="mailbox-heading">Email for the things<br class="desktop-break" /> you don’t want to keep.</h1>
    <p>Get a real, temporary address for sign-ups and one-off downloads. No account required.</p>
  </div>

  <div class="mailbox-panel" id="mailbox-root" aria-busy="true">
    <div class="address-row">
      <div class="address-copy">
        <span class="field-label">Your temporary address</span>
        <output class="email-address" id="mailbox-address" aria-live="polite">Connecting to Guerrilla Mail…</output>
      </div>
      <div class="address-actions">
        <button class="button button-outline" id="copy-address" type="button" disabled><span aria-hidden="true">▢</span> Copy</button>
        <button class="button button-outline" id="show-qr" type="button" disabled>QR code</button>
        <button class="button button-primary" id="new-address" type="button">New address</button>
      </div>
    </div>

    <div class="mailbox-meta">
      <span class="status-indicator" id="mailbox-status" role="status" aria-live="polite"><span></span> Connecting</span>
      <span id="expiry-status">Addresses are available for about 60 minutes.</span>
      <button class="text-button" id="extend-address" type="button" disabled>Extend time</button>
    </div>
    <details class="custom-address">
      <summary>Choose an address name</summary>
      <form id="change-address-form">
        <label for="address-name">Name before @</label>
        <input id="address-name" name="user" maxlength="64" autocomplete="off" pattern="[A-Za-z0-9._+-]{1,64}" required />
        <button class="button button-outline" type="submit" id="change-address" disabled>Use this name</button>
      </form>
    </details>

    <div class="mailbox-toolbar">
      <div>
        <h2>Inbox <span class="message-count" id="message-count">0</span></h2>
        <p id="last-updated">Messages refresh automatically every 30 seconds.</p>
      </div>
      <button class="button button-outline" id="refresh-inbox" type="button" disabled><span class="refresh-symbol" aria-hidden="true">↻</span> Refresh</button>
    </div>

    <div class="inbox-layout">
      <div class="message-list" id="message-list" role="list" aria-label="Inbox messages">
        <div class="inbox-empty" id="inbox-state" role="status">Your inbox is ready. New messages will appear here.</div>
      </div>
      <section class="message-reader" id="message-reader" aria-label="Selected message" aria-live="polite">
        <div class="reader-empty">
          <span class="reader-glyph" aria-hidden="true">↳</span>
          <h3>Select a message</h3>
          <p>Choose an email from your inbox to read it here.</p>
        </div>
      </section>
    </div>
    <p class="mailbox-notice">Messages and addresses are managed by Guerrilla Mail. Avoid using temporary email for sensitive accounts or confidential information.</p>
    <p class="mailbox-error" id="mailbox-error" role="alert" hidden></p>
  </div>

  <dialog class="qr-dialog" id="qr-dialog" aria-labelledby="qr-title">
    <div class="dialog-heading"><div><p class="eyebrow">Share locally</p><h2 id="qr-title">Address QR code</h2></div><button class="icon-button" id="close-qr" type="button" aria-label="Close QR code">×</button></div>
    <p>Scan this code to use the current temporary address.</p>
    <img id="qr-image" alt="QR code for the current temporary email address" width="220" height="220" />
    <code id="qr-address"></code>
  </dialog>
</section>

<script>
  import "../scripts/mailbox.js";
</script>
